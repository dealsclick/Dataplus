{
  "id": "/warehouse/mobile",
  "name": "DataPlus Warehouse",
  "short_name": "Warehouse",
  "description": "Scan-first receiving, audits, bins, returns, picking, and inventory for DataPlus warehouse operations.",
  "start_url": "/warehouse/mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#09090b",
  "theme_color": "#7c3aed",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/warehouse-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Receive purchase orders",
      "short_name": "Receiving",
      "url": "/warehouse/mobile/receiving",
      "icons": [{ "src": "/warehouse-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Warehouse audits",
      "short_name": "Audits",
      "url": "/warehouse/mobile/audits",
      "icons": [{ "src": "/warehouse-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Bin tools",
      "short_name": "Bins",
      "url": "/warehouse/mobile/bins",
      "icons": [{ "src": "/warehouse-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
